{
  "name": "circuitgame2",
  "displayName": "Neknaj Circuit Game 2",
  "description": "NCG2 と NCG2M の編集、NCG2 言語サーバーとの接続",
  "version": "0.1.0",
  "publisher": "neknaj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neknaj/circuitgame2-editors"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["Programming Languages"],
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ncg2",
        "aliases": ["NCG2"],
        "extensions": [".ncg2"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ncg2m",
        "aliases": ["NCG2M"],
        "extensions": [".ncg2m"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.ncg2-common",
        "path": "./syntaxes/common.tmLanguage.json"
      },
      {
        "language": "ncg2",
        "scopeName": "source.ncg2",
        "path": "./syntaxes/ncg2.tmLanguage.json"
      },
      {
        "language": "ncg2m",
        "scopeName": "source.ncg2m",
        "path": "./syntaxes/ncg2m.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      { "id": "ncg2Namespace", "superType": "namespace", "description": "名前空間" },
      { "id": "ncg2Function", "superType": "function", "description": "組み合わせ回路" },
      { "id": "ncg2Module", "superType": "function", "description": "順序回路のモジュール" },
      { "id": "ncg2Signal", "superType": "variable", "description": "内部信号" },
      { "id": "ncg2Port", "superType": "parameter", "description": "入出力ポート" }
    ],
    "semanticTokenScopes": [
      {
        "language": "ncg2",
        "scopes": {
          "ncg2Namespace": ["entity.name.namespace"],
          "ncg2Function": ["entity.name.function"],
          "ncg2Module": ["entity.name.function"],
          "ncg2Signal": ["variable.other.readwrite"],
          "ncg2Port": ["variable.parameter"]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "[Dark 2026][*Dark Modern][*Dark+][Visual Studio Dark]": {
          "rules": {
            "ncg2Namespace:ncg2": "#C59AF0",
            "ncg2Function:ncg2": "#EAB46F",
            "ncg2Module:ncg2": "#E3CE72",
            "ncg2Signal:ncg2": "#8FB7EC",
            "ncg2Port:ncg2": "#75D3EB"
          }
        },
        "[Light 2026][*Light Modern][*Light+][Visual Studio Light]": {
          "rules": {
            "ncg2Namespace:ncg2": "#7243A8",
            "ncg2Function:ncg2": "#8A5006",
            "ncg2Module:ncg2": "#816A00",
            "ncg2Signal:ncg2": "#255DAA",
            "ncg2Port:ncg2": "#006F89"
          }
        }
      }
    },
    "configuration": {
      "title": "Neknaj Circuit Game 2",
      "properties": {
        "ncg2.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "言語サーバー circuitgame2-lsp の絶対パス。空の場合は拡張ホストの PATH から起動します。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --out circuitgame2.vsix",
    "test": "node test/run.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "typescript": "5.9.3"
  }
}
